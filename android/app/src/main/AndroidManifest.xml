<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to reach the Claude API for "Break it down". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks the user before an app may show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exact alarms make the timer alert fire on time even when the phone is asleep.
         USE_EXACT_ALARM is granted automatically to timer/alarm apps on Android 13+;
         SCHEDULE_EXACT_ALARM covers Android 12 and 12L. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Read (never change) the calendars synced to the phone, for appointment reminders. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Lets the app put its alarms back after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- allowBackup=false keeps the saved API key out of Google's automatic cloud backups. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taskbreaker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Woken up by the system alarm when the focus timer runs out. -->
        <receiver
            android:name=".timer.TimerAlarmReceiver"
            android:exported="false" />

        <!-- Woken up by the system alarm when it's time to remind about an appointment. -->
        <receiver
            android:name=".calendar.AppointmentAlarmReceiver"
            android:exported="false" />

        <!-- Puts alarms back after a restart, an app update, or a clock/time-zone change.
             exported=true is required to hear these system messages; only Android can send them. -->
        <receiver
            android:name=".calendar.RestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Background job that refreshes appointment reminders when the calendar changes. -->
        <service
            android:name=".calendar.CalendarSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
